// The clip: a full chase, three times, each with more stars and more cops.
SigfDemo(0.5, function() { SigfLook(16, ::SigfYaw); ::GtaRestart() })
SigfDemo(1.5, function() { SigfCaption("GTA V takes over the test chamber", 4) })
SigfDemo(5.5, function() { SigfCaption("Taxis ram into the cops", 3) })
SigfDemo(7.0, function() { SigfCaption("Every cop that falls gets WASTED", 3) })
SigfDemo(18.5, function() { SigfCaption("Mission passed: cash rains down", 3) })
SigfDemo(25.0, function() { SigfCaption("Three stars: more cops", 3) })
SigfDemo(52.5, function() { SigfCaption("Five stars: the whole city is after you", 4) })
